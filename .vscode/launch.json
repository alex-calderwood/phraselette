{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Decoding",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/back-end/decoding/gpt.py",
            "console": "integratedTerminal",
            "justMyCode":false,
        }
    ]
}